+// Copyright 2025 The Chromium Authors. Desktop page (workspace home) mock.
+
+interface AppEntry {
+  name: string;
+  domain: string;
+  char: string;
+  color: [string, string];
+  url: string;
+  small?: boolean;
+}
+
+const APPS: AppEntry[] = [
+  {name: '淘宝网', domain: 'taobao.com', char: '淘',
+   color: ['#ff8a3c', '#ff5000'], url: 'https://www.taobao.com/'},
+  {name: '千牛工作台', domain: 'myseller.taobao.com', char: '千',
+   color: ['#ffb14a', '#ff7a00'], url: 'https://myseller.taobao.com/'},
+  {name: '生意参谋', domain: 'sycm.taobao.com', char: '参',
+   color: ['#5b9bf9', '#2f6ef2'], url: 'https://sycm.taobao.com/'},
+  {name: '达摩盘', domain: 'dmp.taobao.com', char: '摩',
+   color: ['#8a7bf5', '#5a4bd6'], url: 'https://dmp.taobao.com/'},
+  {name: '1688', domain: '1688.com', char: '1688', small: true,
+   color: ['#ff9d43', '#f45d04'], url: 'https://www.1688.com/'},
+  {name: '无限画布', domain: 'drawnix.com', char: '画',
+   color: ['#3fc37a', '#1e9e57'], url: 'https://drawnix.com/'},
+  {name: 'BI系统', domain: 'go.ecbis.cn', char: 'BI',
+   color: ['#38b577', '#178a56'], url: 'https://go.ecbis.cn/'},
+  {name: '研报分析', domain: 'agent.ecbis.cn', char: '研',
+   color: ['#38b577', '#178a56'], url: 'https://agent.ecbis.cn/'},
+  {name: '小红书', domain: 'xiaohongshu.com', char: '红',
+   color: ['#ff4d6a', '#e6203f'], url: 'https://www.xiaohongshu.com/'},
+  {name: '抖音', domain: 'douyin.com', char: '抖',
+   color: ['#2b2b36', '#111118'], url: 'https://www.douyin.com/'},
+  {name: '京东', domain: 'jd.com', char: '京',
+   color: ['#e8453a', '#c6281c'], url: 'https://www.jd.com/'},
+  {name: 'AI助手', domain: '智能工作助手', char: '✦',
+   color: ['#9b6ef8', '#6d3fe0'], url: ''},
+  {name: '文件系统', domain: '我的文件管理', char: '🗂',
+   color: ['#f5b93c', '#dd9704'], url: ''},
+  {name: '任务管理', domain: '我的任务列表', char: '✓',
+   color: ['#3ec4b0', '#1f9c89'], url: ''},
+  {name: '技能市场', domain: '发现更多实用技能', char: '▦',
+   color: ['#8a6bf5', '#5a3fd6'], url: ''},
+];
+
+function greetingForHour(hour: number): string {
+  if (hour < 6) {
+    return '夜深了';
+  }
+  if (hour < 12) {
+    return '上午好';
+  }
+  if (hour < 18) {
+    return '下午好';
+  }
+  return '晚上好';
+}
+
+function renderGreeting(): void {
+  const now = new Date();
+  document.getElementById('greeting')!.textContent =
+      greetingForHour(now.getHours()) + '，';
+  const nameSpan = document.createElement('span');
+  nameSpan.textContent = 'YangHan';
+  document.getElementById('greeting')!.appendChild(nameSpan);
+}
+
+function renderClock(): void {
+  const now = new Date();
+  const hh = String(now.getHours()).padStart(2, '0');
+  const mm = String(now.getMinutes()).padStart(2, '0');
+  document.getElementById('clock')!.textContent = hh + ':' + mm;
+  const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
+  document.getElementById('date')!.textContent =
+      now.getMonth() + 1 + '月' + now.getDate() + '日 星期' +
+      weekdays[now.getDay()];
+}
+
+function renderApps(): void {
+  const grid = document.getElementById('app-grid')!;
+  for (const app of APPS) {
+    const card = document.createElement('a');
+    card.className = 'card';
+    if (app.url) {
+      card.href = app.url;
+    } else {
+      card.href = '#';  // Placeholder entry.
+    }
+    const icon = document.createElement('div');
+    icon.className = app.small ? 'card-icon small-text' : 'card-icon';
+    icon.textContent = app.char;
+    icon.style.background =
+        'linear-gradient(135deg, ' + app.color[0] + ', ' + app.color[1] + ')';
+    const name = document.createElement('div');
+    name.className = 'card-name';
+    name.textContent = app.name;
+    const domain = document.createElement('div');
+    domain.className = 'card-domain';
+    domain.textContent = app.domain;
+    card.appendChild(icon);
+    card.appendChild(name);
+    card.appendChild(domain);
+    grid.appendChild(card);
+  }
+}
+
+renderGreeting();
+renderClock();
+setInterval(renderClock, 1000);
+renderApps();
