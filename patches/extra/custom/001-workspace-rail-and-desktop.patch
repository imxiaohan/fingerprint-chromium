@@ -0,0 +1,142 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/workspace/workspace_rail_view.h"
+
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_navigator.h"
+#include "chrome/browser/ui/browser_navigator_params.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/background.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/fill_layout.h"
+
+namespace {
+
+constexpr SkColor kRailBackground = SkColorSetRGB(0xF7, 0xF9, 0xFC);
+constexpr SkColor kItemForeground = SkColorSetRGB(0x4E, 0x55, 0x60);
+constexpr SkColor kAvatarBlue = SkColorSetRGB(0x4F, 0x7D, 0xF7);
+constexpr int kIconSize = 22;
+constexpr int kItemHeight = 52;
+
+// views::Button's constructor is protected; expose a concrete subclass for
+// simple custom rail buttons.
+class RailButton : public views::Button {
+  METADATA_HEADER(RailButton, views::Button)
+
+ public:
+  explicit RailButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {}
+};
+
+}  // namespace
+
+WorkspaceRailView::WorkspaceRailView(Browser* browser) : browser_(browser) {
+  SetBackground(views::CreateSolidBackground(kRailBackground));
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(20, 0, 16, 0), 2));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // Letter avatar.
+  auto avatar_button = std::make_unique<RailButton>(
+      base::BindRepeating(&WorkspaceRailView::OpenUrl, base::Unretained(this),
+                          GURL("chrome://version")));
+  avatar_button->GetViewAccessibility().SetName(u"用户头像");
+  avatar_button->SetPreferredSize(gfx::Size(40, 40));
+  avatar_button->SetBackground(
+      views::CreateRoundedRectBackground(kAvatarBlue, 20));
+  avatar_button->SetLayoutManager(std::make_unique<views::FillLayout>());
+  auto avatar_label = std::make_unique<views::Label>(u"Y");
+  avatar_label->SetAutoColorReadabilityEnabled(false);
+  avatar_label->SetEnabledColor(SK_ColorWHITE);
+  avatar_label->SetFontList(avatar_label->font_list().DeriveWithWeight(
+      gfx::Font::Weight::MEDIUM));
+  avatar_label->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_CENTER);
+  avatar_label->SetVerticalAlignment(gfx::VerticalAlignment::ALIGN_MIDDLE);
+  avatar_button->AddChildView(std::move(avatar_label));
+  AddChildView(std::move(avatar_button));
+
+  AddRailItem(
+      u"桌面", kNavigateHomeChromeRefreshIcon,
+      base::BindRepeating(&WorkspaceRailView::OpenUrl, base::Unretained(this),
+                          GURL("chrome://desktop")));
+  AddRailItem(u"AI", kDraftSparkIcon, base::DoNothing());
+  AddRailItem(u"文件", vector_icons::kFolderIcon, base::DoNothing());
+  AddRailItem(u"技能", vector_icons::kStarIcon, base::DoNothing());
+  AddRailItem(u"任务", kCheckIcon, base::DoNothing());
+
+  // Flexible spacer pushes the utilities to the bottom.
+  views::View* spacer = AddChildView(std::make_unique<views::View>());
+  layout->SetFlexForView(spacer, 1);
+
+  AddIconButton(
+      vector_icons::kSettingsOutlineIcon,
+      base::BindRepeating(&WorkspaceRailView::OpenUrl, base::Unretained(this),
+                          GURL("chrome://settings")),
+      u"设置");
+}
+
+WorkspaceRailView::~WorkspaceRailView() = default;
+
+void WorkspaceRailView::AddRailItem(const std::u16string& text,
+                                    const gfx::VectorIcon& icon,
+                                    base::RepeatingClosure callback) {
+  auto button = std::make_unique<RailButton>(std::move(callback));
+  button->SetPreferredSize(gfx::Size(kRailWidth, kItemHeight));
+  auto* box = button->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::TLBR(6, 0, 4, 0),
+      2));
+  box->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  auto image = std::make_unique<views::ImageView>(
+      ui::ImageModel::FromVectorIcon(icon, kItemForeground, kIconSize));
+  button->AddChildView(std::move(image));
+
+  auto label = std::make_unique<views::Label>(text);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(kItemForeground);
+  label->SetFontList(label->font_list().DeriveWithSizeDelta(-1));
+  button->AddChildView(std::move(label));
+
+  button->GetViewAccessibility().SetName(text);
+  AddChildView(std::move(button));
+}
+
+void WorkspaceRailView::AddIconButton(const gfx::VectorIcon& icon,
+                                      base::RepeatingClosure callback,
+                                      const std::u16string& name) {
+  auto button = std::make_unique<RailButton>(std::move(callback));
+  button->SetPreferredSize(gfx::Size(36, 36));
+  button->AddChildView(std::make_unique<views::ImageView>(
+      ui::ImageModel::FromVectorIcon(icon, kItemForeground, 20)));
+  button->GetViewAccessibility().SetName(name);
+  AddChildView(std::move(button));
+}
+
+void WorkspaceRailView::OpenUrl(const GURL& url) {
+  NavigateParams params(browser_.get(), url,
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::CURRENT_TAB;
+  Navigate(&params);
+}
+
+BEGIN_METADATA(RailButton)
+END_METADATA
+
+BEGIN_METADATA(WorkspaceRailView)
+END_METADATA
