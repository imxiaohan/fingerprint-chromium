@@ -0,0 +1,163 @@
+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="utf-8">
+  <title>桌面</title>
+  <style>
+    * {
+      margin: 0;
+      padding: 0;
+      box-sizing: border-box;
+    }
+
+    html,
+    body {
+      height: 100%;
+    }
+
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
+          'Microsoft YaHei', sans-serif;
+      background: linear-gradient(135deg, #eaf1fd 0%, #f7fafd 45%, #edf7f1 100%);
+      color: #1f2329;
+    }
+
+    .page {
+      max-width: 1160px;
+      margin: 0 auto;
+      padding: 64px 48px;
+    }
+
+    .header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      margin-bottom: 56px;
+    }
+
+    .greeting-block {
+      display: flex;
+      align-items: center;
+      gap: 20px;
+    }
+
+    .avatar {
+      width: 60px;
+      height: 60px;
+      border-radius: 16px;
+      background: linear-gradient(135deg, #5b8cf7, #3d6bf0);
+      color: #fff;
+      font-size: 26px;
+      font-weight: 600;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+    }
+
+    .greeting-text h1 {
+      font-size: 26px;
+      font-weight: 600;
+      color: #1f2329;
+    }
+
+    .greeting-text h1 span {
+      color: #3d6bf0;
+    }
+
+    .greeting-text p {
+      margin-top: 6px;
+      font-size: 14px;
+      color: #7a8291;
+    }
+
+    .clock-block {
+      text-align: right;
+    }
+
+    .clock {
+      font-size: 40px;
+      font-weight: 600;
+      color: #1f2329;
+      font-variant-numeric: tabular-nums;
+    }
+
+    .date {
+      margin-top: 4px;
+      font-size: 14px;
+      color: #7a8291;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(5, 1fr);
+      gap: 48px 28px;
+    }
+
+    .card {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 10px;
+      cursor: pointer;
+      text-decoration: none;
+      color: inherit;
+      border-radius: 16px;
+      padding: 20px 8px 16px;
+      transition: transform 0.15s ease, box-shadow 0.15s ease;
+    }
+
+    .card:hover {
+      transform: translateY(-4px);
+      box-shadow: 0 12px 32px rgb(31 60 120 / 0.10);
+    }
+
+    .card-icon {
+      width: 64px;
+      height: 64px;
+      border-radius: 20px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      color: #fff;
+      font-size: 24px;
+      font-weight: 600;
+      box-shadow: 0 6px 16px rgb(31 60 120 / 0.14);
+    }
+
+    .card-icon.small-text {
+      font-size: 17px;
+    }
+
+    .card-name {
+      font-size: 15px;
+      font-weight: 500;
+      color: #1f2329;
+    }
+
+    .card-domain {
+      font-size: 12px;
+      color: #8a919f;
+      margin-top: -6px;
+    }
+  </style>
+</head>
+<body>
+  <div class="page">
+    <header class="header">
+      <div class="greeting-block">
+        <div class="avatar">Y</div>
+        <div class="greeting-text">
+          <h1 id="greeting">你好</h1>
+          <p>欢迎回来！选择应用开始你的工作</p>
+        </div>
+      </div>
+      <div class="clock-block">
+        <div id="clock" class="clock">--:--</div>
+        <div id="date" class="date"></div>
+      </div>
+    </header>
+    <main id="app-grid" class="grid"></main>
+  </div>
+  <script type="module" src="./desktop_page.js"></script>
+</body>
+</html>
